# =============================================================
# VITAL AGE — Umgebungsvariablen (Template)
# KEINE echten Geheimnisse in die Versionierung einchecken.
# Kopiere zu .env und fülle die nötigen Werte.
# =============================================================

# ---------- Lokale Entwicklung ----------
# Port des lokalen API-Servers (server/index.ts)
API_PORT=8787

# ---------- Supabase (optional) ----------
# Ohne diese Werte läuft die App im lokalen Browser-Modus (localStorage).
# Gesundheitsdaten werden in diesem Fall NIE an einen Server gesendet.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ---------- Google Health API ----------
# OAuth-Client-ID/Secret aus dem Google-Cloud-Console-Projekt.
# EINRICHTUNG: docs/GOOGLE-HEALTH-SETUP.md (7-Schritte-Checkliste)
#
# SERVERSEITIG (Client-SECRET — niemals im Frontend/Bundle!):
GOOGLE_HEALTH_CLIENT_ID=
GOOGLE_HEALTH_CLIENT_SECRET=
#
# FRONTEND (öffentlich — Client-ID darf im Browser stehen):
VITE_GOOGLE_HEALTH_CLIENT_ID=
VITE_GOOGLE_HEALTH_REDIRECT_URI=http://localhost:5173/oauth/health/callback

# ---------- Lokale KI (SERVERSEITIG, nie im Frontend) ----------
# Die App-KI läuft mit einem KLEINEN LOKALEN MODALL (Text + Bild für den
# Food-Scanner). Provider-Auflösung: Ollama zuerst, dann LM Studio.
#
# Empfohlene Vision-Modelle (Bild + Text, klein genug für lokal):
#   Ollama:    ollama pull qwen2.5vl:7b   (oder: llava:13b, gemma3:12b)
#   LM Studio: Qwen2.5-VL-7B-Instruct (GGUF Q4/Q5) laden + Server starten
#
# Ollama (Default, läuft auf localhost:11434)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5vl:7b
# LM Studio (Fallback)
LM_STUDIO_BASE_URL=http://192.168.56.1:1234/v1
LM_STUDIO_MODEL=Qwen2.5-VL-7B-Instruct
#
# Falls KEIN lokales Modell läuft: Coach & Scanner fallen automatisch
# auf die regelbasierte Engine / manuelle Auswahl zurück (klar gekennzeichnet).

# ---------- Optional: remote OpenAI-kompatibel (nur wenn lokal nicht möglich) ----------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_API_BASE=https://api.openai.com/v1

# ---------- Supabase Auth (für die OAuth-Tokens im Auth-Flow) ----------
# Wird nur benötigt, wenn Supabase als Auth-Provider genutzt wird.
SUPABASE_SERVICE_ROLE_KEY=
